{
  "openapi": "3.1.0",
  "info": {
    "title": "note",
    "version": "0.1.0",
    "description": "私人便签：页面、搜索、编辑和持久存储均由同一个 WASM 提供。"
  },
  "paths": {
    "/": {"get": {"responses": {"200": {"description": "Note 页面"}}}},
    "/notes": {
      "get": {"responses": {"200": {"description": "便签列表"}, "400": {"description": "搜索输入无效"}, "500": {"description": "存储失败"}}},
      "post": {"responses": {"201": {"description": "已创建"}, "400": {"description": "输入无效"}, "409": {"description": "编号已存在"}, "413": {"description": "内容过大"}, "415": {"description": "需要 JSON"}, "500": {"description": "存储失败或提交结果未确认"}}}
    },
    "/note": {
      "get": {"responses": {"200": {"description": "便签及 ETag"}, "400": {"description": "编号无效"}, "404": {"description": "便签不存在"}, "500": {"description": "存储失败"}}},
      "put": {"responses": {"200": {"description": "已保存及新 ETag"}, "400": {"description": "输入无效"}, "404": {"description": "便签不存在"}, "412": {"description": "版本冲突"}, "413": {"description": "内容过大"}, "415": {"description": "需要 JSON"}, "428": {"description": "缺少 If-Match"}, "500": {"description": "存储失败或提交结果未确认"}}},
      "delete": {"responses": {"204": {"description": "已删除"}, "400": {"description": "编号无效"}, "404": {"description": "便签不存在"}, "412": {"description": "版本冲突"}, "428": {"description": "缺少 If-Match"}, "500": {"description": "存储失败或提交结果未确认"}}}
    }
  }
}
