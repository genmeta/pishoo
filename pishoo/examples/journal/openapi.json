{
  "openapi": "3.1.0",
  "info": {
    "title": "手记",
    "version": "0.1.0",
    "description": "记下生活里的小事，留住值得回看的瞬间。用文字和照片写手记，按月份翻阅往日记录，与朋友留言交流。简洁的阅读与写作界面，适合在手机和电脑上随时记录。",
    "license": {
      "name": "Apache-2.0"
    }
  },
