{
  "openapi": "3.1.0",
  "info": {
    "title": "Pishoo identity example",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Read the authenticated invocation identity",
        "responses": {
          "200": {
            "description": "Local name, optional caller name and owner status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["local_name", "caller_name", "caller_is_owner"],
                  "properties": {
                    "local_name": { "type": "string" },
                    "caller_name": { "type": ["string", "null"] },
                    "caller_is_owner": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "Read response headers without a body",
        "responses": { "200": { "description": "Identity response headers" } }
      }
    }
  }
}
