package pishoo:sdk;

world sdk {
    include identity-v1;
    include identity-v2;
    include call-context;
}

world identity-v1 {
    import pishoo:identity/request-identity@0.1.0;
    import pishoo:identity/signatures@0.1.0;
}

world identity-v2 {
    import pishoo:identity/request-identity@0.2.0;
}

world call-context {
    import pishoo:identity/call-context@0.3.0;
}

package pishoo:identity@0.1.0 {
    /// Read-only identity of this invocation, taken from the verified handshake.
    /// These operations never consult HTTP headers or guest-supplied identity data.
    interface request-identity {
        local-name: func() -> string;
        caller-name: func() -> option<string>;
        /// Both the normalized name and certificate owner_hash must match.
        /// Anonymous callers and unavailable certificate identifiers return false.
        caller-is-owner: func() -> bool;
    }

    /// Host operations on DHTTP identity signatures. The signing identity is
    /// selected by the host from the current Server, never by the guest.
    interface signatures {
        variant sign-error {
            denied,
            input-too-large,
            unavailable,
            failed,
        }

        variant verify-error {
            invalid-identity,
            unknown-identity,
            no-trusted-certificate,
            input-too-large,
            unavailable,
            failed,
        }

        /// Sign exactly the supplied bytes with the current Server identity.
        sign: func(data: list<u8>) -> result<list<u8>, sign-error>;

        /// A valid signature returns true; a mismatched signature returns false.
        verify: func(signature: list<u8>, data: list<u8>, identity: string) -> result<bool, verify-error>;
    }
}

package pishoo:identity@0.2.0 {
    /// Verified invocation identity. Tuple order is (name, owner-hash from SKI).
    /// No HTTP headers or guest-supplied values contribute to these facts.
    interface request-identity {
        local: func() -> tuple<string, string>;
        /// Anonymous HTTP requests and background runs have no caller.
        caller: func() -> option<tuple<string, string>>;
    }
}

package pishoo:identity@0.3.0 {
    /// Host-established direct service identity. Tuple order is full author/package,
    /// bound owner hash, and executing package version. Installed packages bind
    /// their verified author. Owner-managed previews bind the execution owner.
    interface call-context {
        caller-service: func() -> option<tuple<string, string, string>>;
    }
}
