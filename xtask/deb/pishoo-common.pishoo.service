# Root discovers the DHTTP global home and system-account homes by default.
# Administrator service overrides remain authoritative.
[Unit]
Description=A modern, secure, QUIC-powered, peer-to-peer web/proxy engine
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/pishoo
TimeoutStopSec=infinity
KillMode=mixed
Restart=on-failure

[Install]
WantedBy=multi-user.target
