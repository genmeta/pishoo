# Initialization belongs to the process that owns DHTTP_HOME.
# Configure User= and Environment=DHTTP_HOME= in a service override when using a user's identities.
[Unit]
Description=A modern, secure, QUIC-powered, peer-to-peer web/proxy engine
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/pishoo
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStopSec=infinity
KillMode=mixed
Restart=on-failure

[Install]
WantedBy=multi-user.target