#!/bin/sh
set -e
case "$1" in
    configure)
        # BEGIN service-home setup (also embedded in the RPM postinstall)
        service_directory=/etc/systemd/system/pishoo.service.d
        service_override=$service_directory/identity-home.conf
        # Retire only the previous package-generated single-user override.
        # Customized files, symlinks and other administrator overrides are preserved.
        if [ -f "$service_override" ] && [ ! -L "$service_override" ] &&
           awk 'NR == 1 { valid = ($0 == "# Generated by pishoo-common.") }
                NR == 2 { valid = valid && ($0 == "[Service]") }
                NR == 3 { valid = valid && ($0 ~ /^User=[^=[:space:]]+$/) }
                NR == 4 { valid = valid && ($0 ~ /^Environment="DHTTP_HOME=\/.*"$/) }
                END { exit !(valid && NR == 4) }' "$service_override"; then
            rm -f "$service_override"
            rmdir "$service_directory" 2>/dev/null || true
        fi
        # END service-home setup
        install -d -m 0755 /etc/dhttp
        ;;
esac
#DEBHELPER#
exit 0
