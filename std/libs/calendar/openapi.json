{
  "openapi": "3.1.0",
  "info": {
    "title": "Calendar",
    "version": "0.1.0",
    "description": "Owner-only personal calendar with private SQLite storage and optimistic concurrency. Errors follow RFC 9457.",
    "license": {
      "name": "Apache-2.0"
    }
  },
  "x-pishoo": {
    "access-groups": {
      "read": {
        "title": "Read calendar",
        "operations": [
          "listCalendarEvents",
          "getCalendarEvent"
        ]
      },
      "write": {
        "title": "Manage calendar",
        "operations": [
          "createCalendarEvent",
          "updateCalendarEvent",
          "deleteCalendarEvent"
        ]
      }
    }
  },
  "paths": {
    "/calendar/events": {
      "get": {
        "operationId": "listCalendarEvents",
        "summary": "List events intersecting a time range",
        "x-pishoo": {
          "access-group": "read"
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "events"
                  ],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CalendarEvent"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Owner identity or daccess permission required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Request or result exceeds size limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Storage failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Storage busy",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ]
      },
      "post": {
        "operationId": "createCalendarEvent",
        "summary": "Create an event",
        "x-pishoo": {
          "access-group": "write"
