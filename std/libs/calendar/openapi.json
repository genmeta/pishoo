  "components": {
    "schemas": {
      "EventInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "location",
          "start_at",
          "end_at",
          "all_day",
          "color"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 8000
          },
          "location": {
            "type": "string",
            "maxLength": 240
          },
          "start_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 253402300799999,
            "description": "Unix milliseconds. All-day dates use UTC midnight."
          },
          "end_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 253402300799999,
            "description": "Exclusive end, after start_at. All-day dates use UTC midnight."
          },
          "all_day": {
            "type": "boolean"
          },
          "color": {
            "type": "string",
            "enum": [
              "blue",
              "green",
              "yellow",
              "purple",
              "pink"
            ]
          }
        }
      },
      "CalendarEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "location",
          "start_at",
          "end_at",
          "all_day",
          "color",
          "id",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 8000
          },
          "location": {
            "type": "string",
            "maxLength": 240
          },
          "start_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 253402300799999,
            "description": "Unix milliseconds. All-day dates use UTC midnight."
          },
          "end_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 253402300799999,
            "description": "Exclusive end, after start_at. All-day dates use UTC midnight."
          },
          "all_day": {
            "type": "boolean"
          },
          "color": {
            "type": "string",
            "enum": [
              "blue",
              "green",
              "yellow",
              "purple",
              "pink"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "updated_at": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "EventUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "location",
          "start_at",
          "end_at",
          "all_day",
          "color",
          "updated_at"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 8000
          },
          "location": {
            "type": "string",
            "maxLength": 240
          },
          "start_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 253402300799999,
            "description": "Unix milliseconds. All-day dates use UTC midnight."
          },
          "end_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 253402300799999,
            "description": "Exclusive end, after start_at. All-day dates use UTC midnight."
          },
          "all_day": {
            "type": "boolean"
          },
          "color": {
            "type": "string",
            "enum": [
              "blue",
              "green",
              "yellow",
              "purple",
              "pink"
            ]
          },
          "updated_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
